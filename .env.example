# SQLite local database (no PostgreSQL required for development)
DATABASE_URL="file:./prisma/dev.db"

# Redis / BullMQ — required only for domain scanning, not for login
REDIS_URL="redis://localhost:6379"

# Authentication
AUTH_SECRET="local-dev-auth-secret-change-this-before-production"
APP_URL="http://localhost:3000"
SESSION_TTL_DAYS="30"

# Seeded main admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin1234"
ADMIN_NAME="Main Administrator"

# Public receiving addresses only. Never place private keys or seed phrases here.
BTC_ADDRESS="bc1qhd0aau0u8xsrnxdxmq7ta7950y8tdgyksr655j"
SOL_ADDRESS="7L97rEXcMwPxAzZjwrFYDgpuu6mM4MEBYJ4sgHbmgv5r"
ETH_ADDRESS="0xb9651ed7618F535D854667e5fe71daf836A2dEAE"

# Optional SMTP integration for password-reset delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ghost Mail Finder <noreply@example.com>"
